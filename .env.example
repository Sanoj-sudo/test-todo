# --- App ---
PORT=3000
# Bind to localhost when running behind nginx on EC2
HOST=127.0.0.1

# --- Database (AWS RDS for MySQL) ---
# Endpoint from RDS console -> Databases -> <your-db> -> Connectivity & security
DB_HOST=database-1.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=change-me
# Created automatically on first start if it doesn't exist
DB_NAME=todoapp

# Encrypt the connection to RDS. The CA bundle is downloaded to
# certs/global-bundle.pem by deploy/setup-ec2.sh.
DB_SSL=true
# DB_SSL_CA=certs/global-bundle.pem
DB_POOL_MAX=10

# Set to true only after HTTPS is set up (ALB or certbot)
ENABLE_HSTS=false
